# /etc/amp-orbs-pve/provider.env
# Read by systemd and by the amp-orbs-pve CLI: plain KEY=value lines, no quotes.

# From Amp: Settings -> Orbs -> Add Orb Provider (shown once).
AMP_ORB_PROVIDER_TOKEN=

# Proxmox VE API. host/setup-access.sh creates the token.
PVE_API_URL=https://192.0.2.10:8006
PVE_TOKEN_ID=amp-orbs@pve!provider
PVE_TOKEN_SECRET=
# Node that holds the base template and runs the orbs.
PVE_NODE=pve
PVE_POOL=amp-orbs
# The cluster CA from /etc/pve/pve-root-ca.pem on the host. Set
# PVE_TLS_INSECURE=1 instead to skip verification (not recommended).
PVE_CA_FILE=/etc/amp-orbs-pve/pve-root-ca.pem

# Optional settings (defaults shown).
# Orb image passed to Amp and matched against template descriptions.
#ORB_IMAGE=us-central1-docker.pkg.dev/amp-prod-0/amp-orb/amp-orb:latest
# VMIDs used for orbs and project snapshots.
#ORB_VMID_MIN=20000
#ORB_VMID_MAX=29999
# linked: fast, thin clones that depend on their template. full: independent copies.
#ORB_CLONE=linked
# hibernate: save RAM to disk so processes survive a pause. shutdown: stop the VM.
#ORB_PAUSE=hibernate
# Storage for hibernation state; defaults to the VM's disk storage.
#ORB_STATE_STORAGE=
# Override the template's size for new orbs.
#ORB_CORES=
#ORB_MEMORY_MB=
# Minimum RAM the host may balloon an orb down to; defaults to all of its RAM.
# Orbs boot at this minimum, and Amp limits their commands to the RAM seen at boot.
#ORB_BALLOON_MB=
# Refuse to create new orbs while this many are running (0 = no limit).
#ORB_MAX_RUNNING=0
